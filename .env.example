# Copy this file to .env and fill in your values
# .env is gitignored — never commit real credentials

# RIPE Atlas API key (create at https://atlas.ripe.net/profile/)
RIPE_ATLAS_PRIMARY_KEY=your_ripe_atlas_api_key_here

# Google Cloud project ID for BigQuery/M-Lab access
GCP_PROJECT_ID=your-gcp-project-id
